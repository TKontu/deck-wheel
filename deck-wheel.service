[Unit]
Description=deck-wheel: on-screen hotkey wheels for the Deck sticks (Desktop Mode)
PartOf=graphical-session.target
After=plasma-workspace.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/deck-wheel/deck_wheel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
